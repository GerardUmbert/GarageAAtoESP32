        android:strokeColor="#FFEAECED"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:pathData="M2,65 a63,63 0 1,0 126,0 a63,63 0 1,0 -126,0 z" />

    <!-- G-mark: original 24x24 donut scaled x2 and centered (12,12 -> 65,65) -->
