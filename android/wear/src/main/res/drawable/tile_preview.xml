        android:scaleX="2"
        android:scaleY="2"
        android:translateX="41"
        android:translateY="41">
        <path
            android:fillColor="#FFEAECED"
            android:fillType="evenOdd"
            android:pathData="M12,1 a11,11 0 1,0 0.001,0 z M12,5.6 a6.4,6.4 0 1,1 -0.001,0 z" />
        <path
            android:fillColor="#FFEAECED"
            android:pathData="M12,9.5 H23 V14.5 H12 Z" />
    </group>
