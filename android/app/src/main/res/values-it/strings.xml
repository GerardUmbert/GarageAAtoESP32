    <string name="perm_dialog_location_title">Posizione precisa richiesta</string>
    <string name="perm_dialog_location_message">Nella schermata successiva, assicurati di abilitare Posizione precisa — la posizione approssimativa non è abbastanza accurata perché la zona di apertura automatica funzioni correttamente.</string>
    <string name="perm_dialog_battery_title">Consenti attività in background</string>
    <string name="perm_dialog_battery_message">Nella schermata successiva, tocca Batteria e poi seleziona \"Senza restrizioni\" affinché l\'app possa aprire il garage in background.</string>
    <string name="perm_dialog_unused_title">Disattiva \"Sospendi se inutilizzata\"</string>
    <string name="perm_dialog_unused_message">Nella schermata successiva, disattiva \"Sospendi attività app se inutilizzata\" in modo che Android non revochi i permessi quando l\'app non viene aperta per un po\'.</string>
