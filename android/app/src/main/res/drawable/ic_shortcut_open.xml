<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark rounded background matching app theme -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#0A0C0E" />
        </shape>
    </item>
    <!-- Garage icon in accent green, inset so it doesn't touch the edges -->
    <item
        android:top="10dp"
        android:bottom="10dp"
        android:left="10dp"
        android:right="10dp">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <!-- Donut: center (12,12), outer r=11, inner r=6.4 -->
            <path
                android:fillColor="#2AD4A3"
                android:fillType="evenOdd"
                android:pathData="M12,1 a11,11 0 1,0 0.001,0 z M12,5.6 a6.4,6.4 0 1,1 -0.001,0 z"/>
            <!-- Tongue: extends from center to outer edge -->
            <path
                android:fillColor="#2AD4A3"
                android:pathData="M12,9.5 H23 V14.5 H12 Z"/>
        </vector>
    </item>
</layer-list>
