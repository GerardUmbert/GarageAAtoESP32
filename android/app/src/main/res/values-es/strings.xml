    <string name="perm_dialog_location_title">Se necesita ubicación precisa</string>
    <string name="perm_dialog_location_message">En la siguiente pantalla, asegúrate de activar Ubicación precisa — la ubicación aproximada no es suficientemente exacta para que la zona de apertura automática funcione correctamente.</string>
    <string name="perm_dialog_battery_title">Permitir actividad en segundo plano</string>
    <string name="perm_dialog_battery_message">En la siguiente pantalla, toca Batería y luego selecciona \"Sin restricciones\" para que la app pueda abrir tu garaje en segundo plano.</string>
    <string name="perm_dialog_unused_title">Desactivar \"Pausar si no se usa\"</string>
    <string name="perm_dialog_unused_message">En la siguiente pantalla, desactiva \"Pausar actividad si no se usa\" para que Android no revoque los permisos cuando la app lleve tiempo sin abrirse.</string>
