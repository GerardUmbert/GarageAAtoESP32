<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        App Action: OPEN_APP_FEATURE built-in intent (BII).
        Google Assistant / Gemini matches natural-language variants of the
        declared phrases and fires the intent into MainCarAppService.
        GarageSession.onNewIntent() detects voice_open=true and calls
        GarageScreen.onVoiceOpen() → triggerOpen().
    -->
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.dunnowsoftware.GarageAAtoESP32"
            android:targetClass="com.dunnowsoftware.GarageAAtoESP32.MainCarAppService">
            <extra android:name="voice_open" android:value="true" />
        </intent>
    </capability>

    <!--
        Static shortcut backing the capability.
        shortcutShortLabel is what the Assistant may speak back as confirmation.
    -->
    <shortcut
        android:shortcutId="open_garage"
        android:shortcutShortLabel="@string/voice_shortcut_label"
        android:enabled="true">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.dunnowsoftware.GarageAAtoESP32"
            android:targetClass="com.dunnowsoftware.GarageAAtoESP32.MainCarAppService">
            <extra android:name="voice_open" android:value="true" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

</shortcuts>
