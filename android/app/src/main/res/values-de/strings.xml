    <string name="perm_dialog_location_title">Genauen Standort erforderlich</string>
    <string name="perm_dialog_location_message">Aktiviere auf dem nächsten Bildschirm Genauer Standort — ungefährer Standort ist nicht präzise genug, damit die automatische Öffnungszone zuverlässig funktioniert.</string>
    <string name="perm_dialog_battery_title">Hintergrundaktivität erlauben</string>
    <string name="perm_dialog_battery_message">Tippe auf dem nächsten Bildschirm auf Akku und wähle dann \"Uneingeschränkt\", damit die App deine Garage im Hintergrund öffnen kann.</string>
    <string name="perm_dialog_unused_title">\"Pausieren bei Nichtverwendung\" deaktivieren</string>
    <string name="perm_dialog_unused_message">Deaktiviere auf dem nächsten Bildschirm \"App-Aktivität pausieren, wenn nicht verwendet\", damit Android die Berechtigungen nicht widerruft, wenn die App längere Zeit nicht geöffnet wurde.</string>
    <string name="perm_dialog_ok">Einstellungen öffnen</string>
    <string name="settings_warn_battery">Hintergrundaktivität eingeschränkt — tippen zum Beheben</string>
    <string name="settings_warn_unused">App kann bei Nichtverwendung pausiert werden — tippen zum Beheben</string>

