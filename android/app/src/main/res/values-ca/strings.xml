    <string name="perm_dialog_location_title">Cal ubicació precisa</string>
    <string name="perm_dialog_location_message">A la pantalla següent, assegura\'t d\'activar Ubicació precisa — la ubicació aproximada no és prou exacta perquè la zona d\'obertura automàtica funcioni correctament.</string>
    <string name="perm_dialog_battery_title">Permet activitat en segon pla</string>
    <string name="perm_dialog_battery_message">A la pantalla següent, toca Bateria i després selecciona \"Sense restriccions\" perquè l\'app pugui obrir el garatge en segon pla.</string>
    <string name="perm_dialog_unused_title">Desactiva \"Posa en pausa si no s\'usa\"</string>
    <string name="perm_dialog_unused_message">A la pantalla següent, desactiva \"Posa en pausa l\'activitat si no s\'usa\" perquè Android no revoqui els permisos quan l\'app porta temps sense obrir-se.</string>
    <string name="perm_dialog_ok">Obre els ajustos</string>
    <string name="settings_warn_battery">Activitat en segon pla restringida — toca per corregir</string>
