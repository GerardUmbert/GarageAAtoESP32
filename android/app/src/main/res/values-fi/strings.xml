    <string name="perm_dialog_location_title">Tarkka sijainti vaaditaan</string>
    <string name="perm_dialog_location_message">Ota seuraavalla näytöllä käyttöön Tarkka sijainti — karkea sijainti ei ole riittävän tarkka automaattisen avausvyöhykkeen luotettavaan toimintaan.</string>
    <string name="perm_dialog_battery_title">Salli tausta-aktiviteetti</string>
    <string name="perm_dialog_battery_message">Napauta seuraavalla näytöllä Akku ja valitse sitten \"Rajoittamaton\", jotta sovellus voi avata autotallin taustalla.</string>
    <string name="perm_dialog_unused_title">Poista käytöstä \"Keskeytä jos käyttämättä\"</string>
    <string name="perm_dialog_unused_message">Poista seuraavalla näytöllä käytöstä \"Keskeytä sovelluksen toiminta, jos sitä ei käytetä\", jotta Android ei peruuta lupia sovelluksen pitkän käyttämättömyyden aikana.</string>
