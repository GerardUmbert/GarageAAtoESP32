    <string name="perm_dialog_location_title">Localisation précise requise</string>
    <string name="perm_dialog_location_message">Sur l\'écran suivant, active bien Localisation précise — la localisation approximative n\'est pas assez précise pour que la zone d\'ouverture automatique fonctionne correctement.</string>
    <string name="perm_dialog_battery_title">Autoriser l\'activité en arrière-plan</string>
    <string name="perm_dialog_battery_message">Sur l\'écran suivant, appuie sur Batterie puis sélectionne \"Sans restriction\" pour que l\'app puisse ouvrir ton garage en arrière-plan.</string>
    <string name="perm_dialog_unused_title">Désactiver \"Mettre en veille si inutilisée\"</string>
    <string name="perm_dialog_unused_message">Sur l\'écran suivant, désactive \"Mettre en veille l\'activité si inutilisée\" pour qu\'Android ne révoque pas les autorisations quand l\'app n\'a pas été ouverte depuis un moment.</string>
