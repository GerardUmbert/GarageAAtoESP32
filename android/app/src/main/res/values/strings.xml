    <!-- Battery / unused-app permission instruction dialogs -->
    <string name="perm_dialog_location_title">Precise location needed</string>
    <string name="perm_dialog_location_message">On the next screen, make sure to enable Precise location — approximate location isn\'t accurate enough for the auto-open zone to work reliably.</string>
