    <string name="onboarding_bg_location_title">Allow background location</string>
    <string name="onboarding_bg_location_body">The auto-open zone only works while you\'re driving, so the app needs location access even when it isn\'t open. Choose \"Allow all the time\" on the next screen.</string>
    <string name="onboarding_notifications_title">Allow notifications</string>
    <string name="onboarding_notifications_body">You\'ll get a notification each time the garage opens automatically so you know it worked.</string>
    <string name="onboarding_battery_title">Allow background activity</string>
    <string name="onboarding_battery_body">You\'ll land on the App Info screen. Tap Battery, then choose the least restrictive option available (e.g. \"Unrestricted\" or \"No restrictions\") so the app can open your garage in the background.</string>
