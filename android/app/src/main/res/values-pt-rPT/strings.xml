    <string name="perm_dialog_location_title">Localização precisa necessária</string>
    <string name="perm_dialog_location_message">No ecrã seguinte, certifica-te de ativar Localização precisa — a localização aproximada não é suficientemente exata para que a zona de abertura automática funcione corretamente.</string>
    <string name="perm_dialog_battery_title">Permitir atividade em segundo plano</string>
    <string name="perm_dialog_battery_message">No ecrã seguinte, toca em Bateria e depois seleciona \"Sem restrições\" para que a app possa abrir a garagem em segundo plano.</string>
    <string name="perm_dialog_unused_title">Desativar \"Pausar se não utilizada\"</string>
    <string name="perm_dialog_unused_message">No ecrã seguinte, desativa \"Pausar atividade da app se não utilizada\" para que o Android não revogue as permissões quando a app não for aberta durante algum tempo.</string>
    <string name="perm_dialog_ok">Abrir definições</string>
    <string name="settings_warn_battery">Atividade em segundo plano restringida — toca para corrigir</string>
    <string name="settings_warn_unused">A app pode ser pausada quando não utilizada — toca para corrigir</string>

