{
  "version": 8,
  "name": "Garage Dark",
  "sources": {
    "ofm": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#121212" } },
    { "id": "landcover-wood", "type": "fill", "source": "ofm", "source-layer": "landcover",
      "filter": ["in", "class", "wood", "grass", "farmland"],
      "paint": { "fill-color": "#141a16", "fill-opacity": 0.9 } },
    { "id": "landuse-residential", "type": "fill", "source": "ofm", "source-layer": "landuse",
      "filter": ["in", "class", "residential", "suburb", "neighbourhood"],
      "paint": { "fill-color": "#161616" } },
    { "id": "landuse-industrial", "type": "fill", "source": "ofm", "source-layer": "landuse",
      "filter": ["in", "class", "industrial", "commercial", "retail"],
      "paint": { "fill-color": "#181818" } },
    { "id": "park", "type": "fill", "source": "ofm", "source-layer": "park",
      "paint": { "fill-color": "#15201a", "fill-opacity": 0.8 } },
    { "id": "water", "type": "fill", "source": "ofm", "source-layer": "water",
      "paint": { "fill-color": "#0a0d12" } },
    { "id": "waterway", "type": "line", "source": "ofm", "source-layer": "waterway",
      "paint": { "line-color": "#0a0d12", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 16, 3] } },
    { "id": "aeroway", "type": "fill", "source": "ofm", "source-layer": "aeroway",
      "filter": ["==", "$type", "Polygon"],
      "paint": { "fill-color": "#1a1a1a" } },
    { "id": "building", "type": "fill", "source": "ofm", "source-layer": "building", "minzoom": 14,
      "paint": { "fill-color": "#1c1c1c", "fill-outline-color": "#242424" } },

    { "id": "road-path", "type": "line", "source": "ofm", "source-layer": "transportation", "minzoom": 14,
      "filter": ["in", "class", "path", "pedestrian", "track"],
      "paint": { "line-color": "#2a2a2a", "line-width": 1, "line-dasharray": [2, 2] } },
    { "id": "road-service-casing", "type": "line", "source": "ofm", "source-layer": "transportation", "minzoom": 14,
      "filter": ["in", "class", "service", "minor"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#262626",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 13, 1, 20, 18] } },
    { "id": "road-minor", "type": "line", "source": "ofm", "source-layer": "transportation", "minzoom": 12,
      "filter": ["in", "class", "minor", "service"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#2e2e2e",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 12, 0.5, 20, 14] } },
    { "id": "road-tertiary", "type": "line", "source": "ofm", "source-layer": "transportation", "minzoom": 11,
      "filter": ["in", "class", "tertiary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#363636",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 11, 0.8, 20, 20] } },
    { "id": "road-secondary", "type": "line", "source": "ofm", "source-layer": "transportation", "minzoom": 9,
      "filter": ["in", "class", "secondary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#404040",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 9, 0.8, 20, 24] } },
    { "id": "road-primary", "type": "line", "source": "ofm", "source-layer": "transportation", "minzoom": 8,
      "filter": ["in", "class", "primary", "trunk"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#4a4a4a",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 8, 0.8, 20, 28] } },
    { "id": "road-motorway", "type": "line", "source": "ofm", "source-layer": "transportation", "minzoom": 5,
      "filter": ["==", "class", "motorway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#555555",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 5, 0.5, 20, 32] } },
    { "id": "rail", "type": "line", "source": "ofm", "source-layer": "transportation", "minzoom": 11,
      "filter": ["==", "class", "rail"],
      "paint": { "line-color": "#2a2a2a", "line-width": 1, "line-dasharray": [3, 3] } },

    { "id": "boundary", "type": "line", "source": "ofm", "source-layer": "boundary",
      "filter": ["<=", "admin_level", 4],
      "paint": { "line-color": "#3a3a3a", "line-width": 1, "line-dasharray": [3, 2] } },

    { "id": "road-label", "type": "symbol", "source": "ofm", "source-layer": "transportation_name", "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11
      },
      "paint": { "text-color": "#8a8a8a", "text-halo-color": "#121212", "text-halo-width": 1.2 } },
    { "id": "water-label", "type": "symbol", "source": "ofm", "source-layer": "water_name",
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": 12
      },
      "paint": { "text-color": "#4a5a70", "text-halo-color": "#0a0d12", "text-halo-width": 1 } },
    { "id": "place-other", "type": "symbol", "source": "ofm", "source-layer": "place",
      "filter": ["in", "class", "suburb", "neighbourhood", "village", "hamlet"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08
      },
      "paint": { "text-color": "#7a7a7a", "text-halo-color": "#121212", "text-halo-width": 1.2 } },
    { "id": "place-city", "type": "symbol", "source": "ofm", "source-layer": "place",
      "filter": ["in", "class", "city", "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 12, 12, 18]
      },
      "paint": { "text-color": "#b5b5b5", "text-halo-color": "#121212", "text-halo-width": 1.5 } }
  ]
}
